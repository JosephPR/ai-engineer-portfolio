# Copy to .env.local and fill in to make the contact form send email.
# Get a key at https://resend.com (the New Dawn site already uses Resend).
RESEND_API_KEY=
# Where contact form messages are delivered.
CONTACT_TO_EMAIL=
# Must be an address on a domain verified in Resend.
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"
